rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catch-all deny for zero-trust security
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Medications subcollection
      match /medications/{medicationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(medicationId);
        allow delete: if isOwner(userId);
      }

      // Health vital sign logs subcollection
      match /healthLogs/{logId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(logId);
        allow delete: if isOwner(userId);
      }

      // Medical appointments subcollection
      match /appointments/{appointmentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(appointmentId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
